      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (item.callback_query) {\n  return [{ json: { type: 'callback', payload: item } }];\n}\n\nif (item.message) {\n  const chatId = item.message.chat.id;\n  const isOwner = chatId === 8893645589;\n\n  const hasText = !!item.message.text;\n  const hasVoice = !!item.message.voice;\n  const hasAudio = !!item.message.audio;\n  const hasPhoto = !!item.message.photo;\n  const hasVideo = !!item.message.video;\n  const hasDocument = !!item.message.document;\n  const hasSticker = !!item.message.sticker;\n\n  if (hasVoice || hasAudio) {\n    return [{ json: { type: 'audio_message', payload: item } }];\n  }\n\n  if (hasPhoto) {\n    return [{ json: { type: 'photo_message', payload: item } }];\n  }\n\n  if (hasVideo) {\n    return [{ json: { type: 'video_message', payload: item } }];\n  }\n\n  if (hasDocument) {\n    return [{ json: { type: 'document_message', payload: item } }];\n  }\n\n  if (hasSticker) {\n    return [{ json: { type: 'unknown', payload: item } }];\n  }\n\n  if (hasText) {\n    return [{ json: { type: isOwner ? 'owner_message' : 'admin_message', payload: item } }];\n  }\n\n  return [{ json: { type: 'unknown', payload: item } }];\n}\n\nreturn [{ json: { type: 'unknown', payload: item } }];"
      },
