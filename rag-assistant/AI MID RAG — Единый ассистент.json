        "jsCode": "const uuid = $execution.id + '_' + Date.now();\n\nconst adminChatId = $('Router').item.json.payload.message.chat.id;\nconst adminUsername = $('Router').item.json.payload.message.chat.username || '';\n\nlet question;\nif ($('Prepare Audio Data').isExecuted) {\n  question = $('Prepare Audio Data').item.json.transcript || '[аудио без текста]';\n} else {\n  question = $('Router').item.json.payload.message.text || '[пусто]';\n}\n\nconst answer = $('AI Agent').item.json.output;\n\nreturn [{\n  json: {\n    uniqueId: uuid,\n    adminChatId: adminChatId,\n    adminUsername: adminUsername,\n    question: question,\n    answer: answer,\n    createdAt: new Date().toISOString()\n  }\n}];"
