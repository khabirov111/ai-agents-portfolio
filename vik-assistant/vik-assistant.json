  "name": "02 — Ислам: ИИ-ассистент ВИК в Telegram",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst m = item.json.message || item.json.edited_message || {};\nif (!m.chat?.id) throw new Error('Не найден chat.id в сообщении Telegram');\nlet inputType = 'text'; let fileId = null;\nlet text = m.text || m.caption || '';\nif (Array.isArray(m.photo) && m.photo.length) { inputType = 'photo'; fileId = m.photo[m.photo.length - 1].file_id; }\nelse if (m.voice?.file_id || m.audio?.file_id) { inputType = 'voice'; fileId = (m.voice || m.audio).file_id; }\nelse if (!text) inputType = 'unsupported';\nconst allowedChatId = 'YOUR_ISLAM_TELEGRAM_CHAT_ID';\nconst authorized = String(m.chat.id) === allowedChatId;\nreturn [{ json: { chatId: m.chat.id, userId: m.from?.id, firstName: m.from?.first_name || '', messageId: m.message_id, inputType, text, fileId, authorized }, binary: item.binary }];"
      },
