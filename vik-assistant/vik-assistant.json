    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json; const base=$('Подготовить поиск в Qdrant').item.json;\nconst hits=r.result||[];\nconst context=hits.map((p,i)=>{const x=p.payload||{}; return `[Фрагмент ${i+1}; страница ${x.page ?? '?'}; документ ${x.document_id||'MU.01.12'}, редакция ${x.revision||4}]\\n${x.text||''}`;}).join('\\n\\n---\\n\\n');\nreturn [{json:{chatId:base.chatId,query:base.query,context,hitCount:hits.length}}];"
      },
      "id": "e1257c16-2199-4cd1-906d-0e8cc2e9c999",
      "name": "Собрать контекст и страницы",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3104,
        224
      ]
