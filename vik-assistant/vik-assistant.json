    {
      "parameters": {
        "method": "POST",
        "url": "https://polza.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_POLZA_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'gpt-4o-mini', temperature: 0.1, max_tokens: 1200, messages: [{ role: 'system', content: 'Ты — инженерный ИИ-ассистент для Ислама, инженера по визуальному и измерительному контролю. Отвечай на русском, ясно и по делу. Основной и единственный нормативный источник для требований — извлечённые фрагменты документа МУ.01.12 редакция 4, переданные в контексте. Не выдумывай нормативы, допуски, размеры, методы, пункты или выводы о соответствии. Если в контексте нет ответа или релевантность слабая, честно скажи, что в доступных фрагментах документа подтверждения нет, и попроси уточнить вопрос/сверить оригинал. Указывай страницу документа в формате «Источник: МУ.01.12, стр. N». Для фото различай наблюдение на изображении и нормативную оценку по документу; не заявляй, что размер измерен по фото без масштаба и калибровки. Если голосовая расшифровка неясна, попроси уточнить. Структура: краткий ответ; затем основание/шаги; затем источник со страницей. Если найденных фрагментов нет, прямо сообщи об этом.' }, { role: 'user', content: 'Вопрос Ислама:\\n' + $('Собрать контекст и страницы').item.json.query + '\\n\\nФрагменты документа из Qdrant (' + $('Собрать контекст и страницы').item.json.hitCount + '):\\n' + ($('Собрать контекст и страницы').item.json.context || '[Qdrant не вернул фрагментов]') } ] } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "3d14c2a4-ff7b-480b-b276-5327f38e000f",
      "name": "Ответить по документу",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3328,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json; const base=$('Собрать контекст и страницы').item.json;\nlet answer=(r.choices?.[0]?.message?.content||'Не удалось сформировать ответ. Попробуйте ещё раз.').trim();\nconst max=3500; const parts=[];\nwhile(answer.length>max){ let cut=answer.lastIndexOf('\\n',max); if(cut<max*0.55) cut=max; parts.push(answer.slice(0,cut)); answer=answer.slice(cut).trim(); }\nif(answer) parts.push(answer);\nreturn parts.map(text=>({json:{chatId:base.chatId,text}}));"
      },
