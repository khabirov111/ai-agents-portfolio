      "parameters": {
        "jsCode": "const ctx = $('Build context').first().json;\nconst p = $('Parse command').first().json;\nlet reply = p.reply || 'Готово!';\ntry { const f = $('Format list reply').first().json; if (f && f.reply) reply = f.reply; } catch(e) {}\ntry { const u = $('Update done').first().json; if (u && u.__reply) reply = u.__reply; } catch(e) {}\nreturn [{ json: { chatId: ctx.chatId, userId: ctx.userId, reply: reply, isVoice: ctx.isVoice } }];"
      },
