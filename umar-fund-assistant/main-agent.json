    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(x => x.json);\nlet msg = { chatId: 'REDACTED_FALLBACK_CHAT_ID', text: '' };\ntry {\n  if ($('Prepare voice').isExecuted) msg = $('Prepare voice').first().json;\n  else if ($('Prepare text').isExecuted) msg = $('Prepare text').first().json;\n} catch (e) {}\nconst d = $('Current Date Info').first().json;\n\n// Передаем ВСЕ задачи агенту, но помечаем их статус\nreturn [{\n  json: {\n    chatId: msg.chatId,\n    userId: msg.userId,\n    text: msg.text,\n    isVoice: msg.isVoice || false,\n    todayISO: d.todayISO,\n    todayHuman: d.todayHuman,\n    todayWeekday: d.todayWeekday,\n    todayTime: d.todayTime,\n    currentYear: d.currentYear,\n    bookings: rows // <-- все строки\n  }\n}];"
      },
