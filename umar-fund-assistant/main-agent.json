      "name": "Create done"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ctx = $('Build context').first().json.bookings || [];\nconst result = [];\nfor (const item of items) {\n  const x = item.json;\n  let booking = ctx.find(bk => String(bk['ID'] || '').trim() === String(x.id).trim());\n  if (!booking && x.description) {\n    const s = String(x.description).toLowerCase();\n    booking = ctx.find(bk => String(bk['Описание'] || '').toLowerCase().includes(s));\n  }\n  if (!booking) continue;\n  \n  // Если агент явно сказал \"Открыто\" - оставляем, иначе \"Закрыто\"\n  const newStatus = (x.status === 'Открыто') ? 'Открыто' : 'Закрыто';\n\n  result.push({ json: {\n    ID: String(booking['ID']).trim(),\n    'Дата': x.date || booking['Дата'],\n    'Тип': x.type || booking['Тип'],\n    'Категория': x.category || booking['Категория'],\n    'Сумма': x.amount ? x.amount : booking['Сумма'],\n    'Описание': x.description || booking['Описание'],\n    'Статус': newStatus,\n    __idx: x.__idx, __total: x.__total, __reply: x.__reply, __action: 'update', chatId: x.chatId, userId: x.userId, isVoice: x.isVoice\n  } });\n}\nreturn result;"
      },
