    {
      "parameters": {
        "jsCode": "const b = $('Normalize input').item.json;\nconst msgDate = new Date(b.msgDate * 1000);\nconst ufa = new Date(msgDate.getTime() + 5 * 60 * 60 * 1000);\nconst day = ufa.getUTCDate();\nconst month = ufa.getUTCMonth();\nconst year = ufa.getUTCFullYear();\nconst hours = String(ufa.getUTCHours()).padStart(2, '0');\nconst minutes = String(ufa.getUTCMinutes()).padStart(2, '0');\nconst months = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];\nconst weekdays = ['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];\nreturn [{\n  json: {\n    todayISO: year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0'),\n    todayHuman: day + ' ' + months[month] + ' ' + year,\n    todayWeekday: weekdays[ufa.getUTCDay()],\n    todayTime: hours + ':' + minutes,\n    currentYear: year\n  }\n}];"
      },
