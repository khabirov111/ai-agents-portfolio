    },
    {
      "parameters": {
        "jsCode": "const allActions = $input.all();\nconst contextBookings = $('Build context').first().json.bookings || [];\nlet reply = '';\n\nfor (const action of allActions) {\n  const filter = String(action.json.filter || '').toLowerCase().trim();\n  let filteredBookings = contextBookings;\n\n  if (filter.startsWith('date=')) {\n    const targetDate = filter.replace('date=', '').trim();\n    filteredBookings = contextBookings.filter(b => String(b['Дата']).trim() === targetDate);\n  } else if (filter === 'open') {\n    filteredBookings = contextBookings.filter(b => String(b['Статус']).trim() === 'Открыто');\n  } else if (filter === 'closed') {\n    filteredBookings = contextBookings.filter(b => String(b['Статус']).trim() === 'Закрыто');\n  } else if (filter === 'all') {\n    filteredBookings = contextBookings;\n  }\n\n  if (filteredBookings.length === 0) {\n    reply += 'Задач не найдено.\\\\n';\n  } else {\n    reply += 'Ваши задачи:\\\\n';\n    filteredBookings.forEach((b, i) => {\n      const sum = Number(b['Сумма']) || 0;\n      const sumStr = sum > 0 ? ` (Сумма: ${sum})` : '';\n      const statusIcon = String(b['Статус']).trim() === 'Закрыто' ? '✅' : '📌';\n      reply += `${i+1}. ${statusIcon} [${b['Дата']}] ${b['Тип']}: ${b['Описание']}${sumStr}\\\\n`;\n    });\n  }\n}\n\nif (!reply.trim()) reply = $('Parse command').first().json.reply || 'Задач нет.';\nreturn [{ json: { chatId: $('Build context').first().json.chatId, reply: reply.trim(), isVoice: $('Build context').first().json.isVoice, userId: $('Build context').first().json.userId } }];"
      },
