    {
      "parameters": {
        "jsCode": "let raw = String($input.first().json.output || '').trim();\n\n// Если ответ не начинается с { - значит агент написал просто текст, оборачиваем в JSON\nif (!raw.startsWith('{')) {\n  raw = JSON.stringify({ actions: [], reply: raw });\n}\n\nconst c = $('Build context').first().json;\nlet parsed;\n\ntry { \n  parsed = JSON.parse(raw); \n} catch(e) { \n  parsed = { actions: [], reply: 'Ой, я запутался. Повтори, пожалуйста.' }; \n}\n\nlet actions = Array.isArray(parsed.actions) ? parsed.actions : (parsed.action ? [parsed] : []);\nconst ALLOWED = ['create','update','list'];\n\nactions = actions.filter(a => a && ALLOWED.includes(a.action)).map(a => ({\n  action: a.action, \n  id: String(a.id || '').trim(), \n  date: String(a.date || '').trim(),\n  type: String(a.type || '').trim(), \n  category: String(a.category || '').trim(),\n  amount: Number(a.amount || 0), \n  description: String(a.description || '').trim(),\n  status: a.status || (a.action === 'update' ? 'Закрыто' : 'Открыто'), \n  filter: String(a.filter || '').trim()\n}));\n\nif (!parsed.reply) {\n  parsed.reply = actions.length > 0 ? 'Готово, Умар!' : 'Не понял запрос.';\n}\n\nreturn [{ json: { ...c, actions, reply: parsed.reply } }];"
      },
