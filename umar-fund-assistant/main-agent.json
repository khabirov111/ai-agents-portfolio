    {
      "parameters": {
        "jsCode": "return $input.all().map(x => ({ json: { __idx: x.json.__idx, __total: x.json.__total, __reply: x.json.__reply, __action: 'create', chatId: x.json.chatId, userId: x.json.userId, isVoice: x.json.isVoice } }));"
